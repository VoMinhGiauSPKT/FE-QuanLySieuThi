# Cấu hình API Backend cho Quản Lý Siêu Thị
# Nếu backend chạy NetBeans/Tomcat:
VITE_API_BASE_URL=http://localhost:8080/QuanLySieuThi/api

# Nếu chạy port khác (ví dụ Node/Express port 3000 hoặc 5000), bạn có thể đổi ở đây:
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_API_BASE_URL=http://localhost:5000/api
